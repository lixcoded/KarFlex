<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/registerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kf_black"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Hero: white panel with back button and vehicle -->

        <LinearLayout
            android:id="@+id/registerHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/kf_white"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="44dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBack"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_back_pill"
                    android:clickable="true"
                    android:drawablePadding="6dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:text="@string/action_back"
                    android:textColor="@color/kf_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_arrow_back"
                    app:drawableTint="@color/kf_text_dark" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_logo_dark"
                    android:contentDescription="@string/cd_logo"
                    android:padding="7dp"
                    android:src="@drawable/ic_logo_k"
                    app:tint="@color/kf_white" />

            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="14dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/vehicle_brio" />

        </LinearLayout>

        <!-- Form sheet -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="34dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_title"
                android:textAppearance="@style/TextAppearance.KarFlex.Display" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/register_subtitle"
                android:textAppearance="@style/TextAppearance.KarFlex.Body" />

            <!-- Username -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:labelFor="@id/etRegisterUsername"
                android:text="@string/label_username"
                android:textAppearance="@style/TextAppearance.KarFlex.Label" />

            <EditText
                android:id="@+id/etRegisterUsername"
                style="@style/Widget.KarFlex.Input"
                android:layout_marginTop="8dp"
                android:autofillHints="username"
                android:hint="@string/hint_register_username"
                android:imeOptions="actionNext"
                android:inputType="text" />

            <!-- Password -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:labelFor="@id/etRegisterPassword"
                android:text="@string/label_password"
                android:textAppearance="@style/TextAppearance.KarFlex.Label" />

            <EditText
                android:id="@+id/etRegisterPassword"
                style="@style/Widget.KarFlex.Input"
                android:layout_marginTop="8dp"
                android:autofillHints="newPassword"
                android:hint="@string/hint_register_password"
                android:imeOptions="actionNext"
                android:inputType="textPassword" />

            <!-- Phone -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:labelFor="@id/etRegisterPhone"
                android:text="@string/label_phone"
                android:textAppearance="@style/TextAppearance.KarFlex.Label" />

            <EditText
                android:id="@+id/etRegisterPhone"
                style="@style/Widget.KarFlex.Input"
                android:layout_marginTop="8dp"
                android:autofillHints="phone"
                android:hint="@string/hint_register_phone"
                android:imeOptions="actionDone"
                android:inputType="phone" />

            <!-- Register Button -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                style="@style/Widget.KarFlex.Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="28dp"
                android:text="@string/action_register" />

            <!-- Login -->

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="@string/register_login_prompt"
                android:textColor="@color/kf_text_link"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
