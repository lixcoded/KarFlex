<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kf_black"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_rental_title"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.KarFlex.Headline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/my_rental_subtitle"
            android:textAppearance="@style/TextAppearance.KarFlex.Body" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRentals"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            tools:itemCount="1"
            tools:listitem="@layout/item_rental" />

        <!-- Empty state -->

        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="40dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_avatar_outline"
                android:contentDescription="@null"
                android:padding="22dp"
                android:src="@drawable/ic_key"
                app:tint="@color/kf_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/empty_rental_title"
                android:textAppearance="@style/TextAppearance.KarFlex.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/empty_rental_body"
                android:textAppearance="@style/TextAppearance.KarFlex.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBrowse"
                style="@style/Widget.KarFlex.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/action_browse_vehicles" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
