<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kf_black"
    android:orientation="vertical"
    tools:context=".VehicleDetailActivity">

    <include layout="@layout/view_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardBackgroundColor="@color/kf_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivDetailVehicle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Vehicle image"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/ic_launcher_foreground" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvDetailBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/kf_text_label"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="HONDA" />

            <TextView
                android:id="@+id/tvDetailModelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/kf_white"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="Vario 160" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:textColor="@color/kf_white"
                    android:textSize="12sp"
                    tools:text="Motorcycle" />

                <TextView
                    android:id="@+id/tvDetailTransmission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:textColor="@color/kf_white"
                    android:textSize="12sp"
                    tools:text="Automatic" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Rental Price"
                android:textColor="@color/kf_text_label"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetailPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/kf_white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="Rp90.000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="/ day"
                    android:textColor="@color/kf_text_label"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Description"
                android:textColor="@color/kf_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/kf_text_label"
                android:textSize="14sp"
                tools:text="A nimble scooter with excellent fuel economy, ideal for city mobility." />

            <TextView
                android:id="@+id/tvRentedOutNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_chip"
                android:padding="16dp"
                android:text="Sorry, this vehicle is currently rented out."
                android:textColor="@color/kf_white"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutRentForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rent This Vehicle"
                    android:textColor="@color/kf_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Rental Duration (Days)"
                    android:textColor="@color/kf_text_label"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etRentalDays"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Enter number of days"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/kf_white"
                    android:textColorHint="@color/kf_text_label" />

                <TextView
                    android:id="@+id/tvDetailTotalPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Total: Rp0"
                    android:textColor="@color/kf_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRentVehicle"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:backgroundTint="@color/kf_text_label"
                    android:text="Rent Now"
                    android:textAllCaps="false"
                    android:textColor="@color/kf_white"
                    android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
