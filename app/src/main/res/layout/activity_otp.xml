<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kf_black"
    android:orientation="vertical"
    tools:context=".OtpActivity">

    <include layout="@layout/view_toolbar" />

    <!-- TODO: OTP form - EditText for the 4-digit code + validation against the code sent by SMS. -->

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Temporary: lets the Home page be reached until the OTP form is built -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        style="@style/Widget.KarFlex.Button.Primary"
        android:layout_width="match_parent"
        android:layout_margin="24dp"
        android:text="@string/action_continue" />

</LinearLayout>
