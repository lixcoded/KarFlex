<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kf_black"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Hero: white panel with logo and vehicle -->

        <LinearLayout
            android:id="@+id/loginHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/kf_white"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="20dp"
            android:paddingEnd="28dp"
            android:paddingBottom="44dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.14"
                        android:text="@string/brand_wordmark"
                        android:textColor="@color/kf_text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.18"
                        android:text="@string/brand_tagline"
                        android:textColor="@color/kf_text_dark_secondary"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/vehicle_avanza" />

        </LinearLayout>

        <!-- Form sheet -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="34dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textAppearance="@style/TextAppearance.KarFlex.Display" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/login_subtitle"
                android:textAppearance="@style/TextAppearance.KarFlex.Body" />

            <!-- Username -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:labelFor="@id/etUsername"
                android:text="@string/label_username"
                android:textAppearance="@style/TextAppearance.KarFlex.Label" />

            <EditText
                android:id="@+id/etUsername"
                style="@style/Widget.KarFlex.Input"
                android:layout_marginTop="8dp"
                android:autofillHints="username"
                android:hint="@string/hint_username"
                android:imeOptions="actionNext"
                android:inputType="text" />

            <!-- Password -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/etPassword"
                android:text="@string/label_password"
                android:textAppearance="@style/TextAppearance.KarFlex.Label" />

            <EditText
                android:id="@+id/etPassword"
                style="@style/Widget.KarFlex.Input"
                android:layout_marginTop="8dp"
                android:autofillHints="password"
                android:hint="@string/hint_password"
                android:imeOptions="actionDone"
                android:inputType="textPassword" />

            <!-- Login Button -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/Widget.KarFlex.Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="28dp"
                android:text="@string/action_login" />

            <!-- Register -->

            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="@string/login_register_prompt"
                android:textColor="@color/kf_text_link"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
