<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.KarFlex.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivRentalVehicle"
                android:layout_width="84dp"
                android:layout_height="96dp"
                android:background="@color/kf_white"
                android:scaleType="fitCenter"
                app:contentPadding="8dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.KarFlex.Media"
                tools:src="@drawable/vehicle_avanza" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRentalBrand"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextAppearance.KarFlex.Label"
                        tools:text="Toyota" />

                    <TextView
                        android:id="@+id/tvRentalStatus"
                        style="@style/Widget.KarFlex.Badge"
                        android:background="@drawable/bg_status_active"
                        android:textColor="@color/kf_green"
                        tools:text="Active" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvRentalModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.KarFlex.Title"
                    tools:text="Toyota Avanza" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_start_date"
                            android:textAppearance="@style/TextAppearance.KarFlex.Micro" />

                        <TextView
                            android:id="@+id/tvRentalStartDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/kf_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="06 Oct 2026" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_duration"
                            android:textAppearance="@style/TextAppearance.KarFlex.Micro" />

                        <TextView
                            android:id="@+id/tvRentalDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/kf_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="3 days" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Update duration form (shown after tapping Update) -->

        <LinearLayout
            android:id="@+id/layoutEditDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/kf_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@id/etDuration"
                android:text="@string/label_new_duration"
                android:textAppearance="@style/TextAppearance.KarFlex.Label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etDuration"
                    style="@style/Widget.KarFlex.Input"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="@string/hint_duration"
                    android:importantForAutofill="no"
                    android:imeOptions="actionDone"
                    android:inputType="number" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveDuration"
                    style="@style/Widget.KarFlex.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="@string/action_save"
                    app:cornerRadius="14dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Actions -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateRental"
                style="@style/Widget.KarFlex.Main.RentalAction"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/action_update" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelRental"
                style="@style/Widget.KarFlex.Main.RentalCancel"
                android:layout_width="0dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/action_cancel" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
