<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========================= -->
    <!-- TEXT                      -->
    <!-- ========================= -->

    <style name="TextAppearance.KarFlex.Display" parent="TextAppearance.AppCompat">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/kf_text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.KarFlex.Headline" parent="TextAppearance.AppCompat">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/kf_text_primary</item>
    </style>

    <style name="TextAppearance.KarFlex.Title" parent="TextAppearance.AppCompat">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/kf_text_primary</item>
    </style>

    <style name="TextAppearance.KarFlex.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/kf_text_secondary</item>
    </style>

    <style name="TextAppearance.KarFlex.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/kf_text_secondary</item>
    </style>

    <style name="TextAppearance.KarFlex.Label" parent="TextAppearance.AppCompat">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/kf_text_label</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.KarFlex.Micro" parent="TextAppearance.AppCompat">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/kf_text_hint</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="TextAppearance.KarFlex.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/kf_text_primary</item>
    </style>

    <style name="TextAppearance.KarFlex.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.KarFlex.NavLabel.Active">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Small uppercase pill used for badges (type, status) -->
    <style name="Widget.KarFlex.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Filter pill on the Browse section (All / Car / Motorcycle) -->
    <style name="Widget.KarFlex.FilterPill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:background">@drawable/bg_filter_pill</item>
        <item name="android:textColor">@color/filter_text_color</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ========================= -->
    <!-- INPUT                     -->
    <!-- ========================= -->

    <style name="Widget.KarFlex.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/kf_text_primary</item>
        <item name="android:textColorHint">@color/kf_text_hint</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- ========================= -->
    <!-- BUTTONS                   -->
    <!-- ========================= -->

    <style name="Widget.KarFlex.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/kf_text_dark</item>
        <item name="backgroundTint">@color/kf_offwhite</item>
        <item name="rippleColor">@color/kf_stroke_light</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.KarFlex.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">46dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/kf_text_primary</item>
        <item name="strokeColor">@color/kf_stroke_strong</item>
        <item name="rippleColor">@color/kf_stroke</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.KarFlex.Button.Danger" parent="Widget.KarFlex.Button.Outlined">
        <item name="android:textColor">@color/kf_red_text</item>
        <item name="strokeColor">@color/kf_red_outline</item>
        <item name="iconTint">@color/kf_red_text</item>
        <item name="rippleColor">@color/kf_red_outline</item>
    </style>

    <!-- Full-width row button (Profile menu) -->
    <style name="Widget.KarFlex.Button.Menu" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/kf_text_primary</item>
        <item name="backgroundTint">@color/kf_surface</item>
        <item name="strokeColor">@color/kf_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/kf_stroke</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconGravity">start</item>
        <item name="iconPadding">16dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@color/kf_text_label</item>
    </style>

    <style name="Widget.KarFlex.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/kf_text_link</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.KarFlex.DialogButton.Danger">
        <item name="android:textColor">@color/kf_red_text</item>
    </style>

    <!-- ========================= -->
    <!-- CARDS, SHAPES, NAV        -->
    <!-- ========================= -->

    <style name="Widget.KarFlex.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/kf_surface</item>
        <item name="strokeColor">@color/kf_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.KarFlex.FeaturedCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/kf_surface_alt</item>
        <item name="strokeColor">@color/kf_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="ShapeAppearance.KarFlex.Media" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearance.KarFlex.FeaturedMedia" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.KarFlex.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.KarFlex.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/kf_black</item>
        <item name="navigationIcon">@drawable/ic_arrow_back</item>
        <item name="navigationIconTint">@color/kf_text_primary</item>
        <item name="navigationContentDescription">@string/action_back</item>
        <item name="titleTextAppearance">@style/TextAppearance.KarFlex.ToolbarTitle</item>
    </style>

    <style name="Widget.KarFlex.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/kf_black</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/nav_icon_tint</item>
        <item name="itemTextColor">@color/nav_text_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.KarFlex.BottomNav.Indicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.KarFlex.NavLabel.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.KarFlex.NavLabel</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.KarFlex.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/kf_white</item>
    </style>

</resources>
